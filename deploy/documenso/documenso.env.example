# Copy to a file named .env next to compose.yml on the host (mode 600). Fill every line.
# Never commit the real file. Make each secret with: openssl rand -hex 24
DOCUMENSO_HOST=sign.example.com
DB_PASSWORD=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_SECONDARY_KEY=
# base64 < wren-sign.p12 | tr -d '\n'
SIGNING_P12_BASE64=
SIGNING_PASSPHRASE=
# false for the first account only; then true.
DISABLE_SIGNUP=false
