# Copy to deploy/prod.env (gitignored) and fill in. push-secrets.sh uploads it to SSM.
# Everything the worker needs that is not in Terraform's Lambda env. No inline comments.
# terraform output -raw database_url
WREN_DATABASE_URL=
WREN_LLM=anthropic
WREN_LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# the crawl's User-Agent contact (email or URL)
WREN_FETCH_CONTACT=
# our SMTP prober on the DB box (deploy/scripts/deploy-prober.sh); token: terraform output -raw probe_token
WREN_VERIFIER=smtp
WREN_SMTP_PROBE_URL=http://<pg_host>:2525
WREN_SMTP_PROBE_TOKEN=
# renderer=cdp (browser_token set in terraform): terraform output -raw cdp_url
WREN_CDP_URL=
# renderer=browserbase (no browser_token): the Browserbase keys instead
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# a path here; the key's JSON is inlined on upload
WREN_GOOGLE_SERVICE_ACCOUNT=~/.config/wren/wren-sender.json
# gmail at cutover
WREN_SEND_TRANSPORT=console
WREN_POSTMASTER_USER=
WREN_REPORT_TO=
WREN_REPORT_FROM=
WREN_PIXEL_BASE_URL=
WREN_PIXEL_EXPORT_TOKEN=
# the fleet's send window, same as .env
WREN_SEND_TIMEZONE=America/Chicago
WREN_CONTENT_CHANNELS=
WREN_CONTENT_VOICE=
# Terraform sets WREN_MEDIA_BUCKET on the Lambda; the CLI's .env takes `tofu output -raw media_bucket`.
WREN_MEDIA_BUCKET=
WREN_META_PAGE_ID=
# The ad account `wren ads` works in (act_… or the bare id); empty = the first account the token admins.
WREN_META_AD_ACCOUNT_ID=
# AdsWatch: 7-day spend that, with zero clicks and zero results, pauses a launch. Default 50.
WREN_ADS_PAUSE_AFTER_USD=
