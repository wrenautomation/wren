    {
      "id": "dedupe",
      "type": "text",
      "x": 0,
      "y": 1110,
      "width": 1820,
      "height": 80,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 18,
      "frameId": null,
      "groupIds": [],
      "index": "b0M",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Claim = one UPDATE ... FOR UPDATE SKIP LOCKED in Postgres: sets lease + fence. Pull workers ask the door (/rt/claim); the box claims for Lambda.\nDedupe, 3 layers: (1) run idem key (job + tick) stops a double insert; (2) one lease holder per run, the fence refuses a stale one;\n(3) each outside act carries an idempotency key, since delivery is at-least-once.",
      "roughness": 1,
      "roundness": null,
      "seed": 1975912794,
      "strokeColor": "#1971c2",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Claim = one UPDATE ... FOR UPDATE SKIP LOCKED in Postgres: sets lease + fence. Pull workers ask the door (/rt/claim); the box claims for Lambda.\nDedupe, 3 layers: (1) run idem key (job + tick) stops a double insert; (2) one lease holder per run, the fence refuses a stale one;\n(3) each outside act carries an idempotency key, since delivery is at-least-once.",
      "textAlign": "left",
      "updated": 1795815620481,
      "version": 1,
      "versionNonce": 1250869080,
      "verticalAlign": "top"
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": null
  }
