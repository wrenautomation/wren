{
  "name": "@wren/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tailwind.css": "./src/tailwind.css",
    "./palette": "./src/palette.tsx",
    "./theme": "./src/theme.tsx",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./toast": "./src/toast.ts",
    "./storybook/frame": "./.storybook/frame.tsx",
    "./storybook/intro": "./.storybook/intro.tsx",
    "./storybook/tests": "./.storybook/story-tests.ts",
    "./fixtures": "./src/fixtures/index.ts",
    "./metro": "./src/metro/index.ts",
    "./metro/shapes": "./src/metro/shapes.ts",
    "./research/run": "./src/research/run/index.ts",
    "./research/run/merge": "./src/research/run/merge.ts"
  },
  "bin": {
    "wren-stories": "./.storybook/run.mjs",
    "wren-shot": "./.storybook/shot.mjs",
    "wren-storybook": "./.storybook/serve.mjs",
    "wren-look": "./.storybook/look.mjs",
    "wren-match": "./.storybook/match.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src",
    "stories:build": "storybook build --quiet",
    "stories:shot": "node .storybook/shot.mjs",
    "test:stories": "node .storybook/run.mjs",
    "engine": "vite build -c .engine/vite.config.ts --outDir"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-ease": "3.0.2",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-timer": "3.0.2",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "@wrenautomation/autobrowse": "0.8.4",
    "agentation": "3.1.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@material/material-color-utilities": "0.3.0",
    "@tanstack/query-async-storage-persister": "5.104.0",
    "@tanstack/query-broadcast-client-experimental": "5.104.0",
    "@tanstack/query-persist-client-core": "5.104.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@wren/core": "workspace:*",
    "@wrenautomation/orrery": "0.68.10",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "d3-ease": "3.0.1",
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-timer": "3.0.1",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "dockview-react": "8.6.2",
    "elkjs": "0.12.0",
    "lucide-react": "1.51.0",
    "motion": "14.0.0",
    "react-hook-form": "7.89.0",
    "react-resizable-panels": "2.1.7",
    "react-textarea-autosize": "8.5.9",
    "recharts": "3.10.1",
