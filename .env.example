# Postgres (docker compose). Password must match WREN_DATABASE_URL.
WREN_DB_PASSWORD=wren
WREN_DATABASE_URL=postgresql://wren:wren@127.0.0.1:5434/wren
# Restate ingress (docker compose)
WREN_RESTATE_INGRESS_URL=http://127.0.0.1:8080
# LinkedIn content pipeline
WREN_INBOX_DIR=inbox
WREN_DRAFTS_DIR=drafts
WREN_LOG_LEVEL=info
