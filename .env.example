# Postgres (docker compose). Password must match WREN_DATABASE_URL.
WREN_DB_PASSWORD=wren
WREN_DATABASE_URL=postgresql://wren:wren@127.0.0.1:5434/wren
# Restate ingress (docker compose)
WREN_RESTATE_INGRESS_URL=http://127.0.0.1:8080
# LinkedIn content pipeline
WREN_INBOX_DIR=inbox
WREN_DRAFTS_DIR=drafts
WREN_LOG_LEVEL=info
# Enrichment / research
# Contact for the outbound User-Agent (email or URL a site operator could reach you at). Required for crawling.
WREN_FETCH_CONTACT=
# warn (fetch anyway, stamp robots_disallowed) | enforce (skip disallowed pages)
WREN_ROBOTS_MODE=warn
# fake | anthropic | groq[:model] | gemini[:model] | openrouter[:model] | cohere[:model] | mistral[:model] | cerebras[:model]
WREN_LLM=fake
WREN_LLM_MODEL=claude-haiku-4-5-20251001
# Key fleets (NUM_<PROVIDER>, <PROVIDER>_API_KEY_N) and WREN_ANTHROPIC_API_KEY live in llm.env (git-ignored).
WREN_LLM_ENV_PATH=llm.env
WREN_TRACING=none
# Mailbox verifier for resolution: fake | millionverifier (MILLIONVERIFIER_API_KEY lives in llm.env)
WREN_VERIFIER=fake
# Send policy (fleet window in WREN_SEND_TIMEZONE; caps per inbox; gap between sends per inbox)
WREN_SEND_TIMEZONE=America/Chicago
WREN_SEND_DAYS=mon,tue,wed,thu,fri
WREN_SEND_WINDOW_START=08:00
WREN_SEND_WINDOW_END=17:00
# Lead's own window on the lead's clock (both or neither)
WREN_SEND_LEAD_WINDOW_START=
WREN_SEND_LEAD_WINDOW_END=
WREN_COLD_SENDS_PER_INBOX_PER_DAY=5
# Ramp: YYYY-MM-DD start (unset = flat cap), from +step every N send days up to the cap above
WREN_COLD_SENDS_RAMP_START=
WREN_COLD_SENDS_RAMP_FROM=5
WREN_COLD_SENDS_RAMP_STEP=2
WREN_COLD_SENDS_RAMP_EVERY_DAYS=3
WREN_SEND_GAP_MIN_MINUTES=8
WREN_SEND_GAP_MAX_MINUTES=20
# Fleet-wide new openers per day (unset = unlimited)
WREN_NEW_OPENERS_PER_DAY=
# Send days of approved openers ComposeScheduler/{niche} keeps queued ahead (0 = never compose)
WREN_COMPOSE_DAYS_AHEAD=3
# A VALID verification older than this no longer counts at compose
WREN_VERIFICATION_HORIZON_DAYS=45
WREN_RESEND_COOLDOWN_DAYS=30
WREN_RECONCILE_GRACE_MINUTES=10
WREN_BOUNCE_PAUSE_RATE=0.02
WREN_BOUNCE_PAUSE_MIN_BOUNCES=2
WREN_HEALTH_WINDOW_DAYS=7
# Open pixel host (unset = none); the /export bearer shared with the pixel worker (secret);
# WREN_OPEN_TRACKING=true puts the pixel into new mail (default false: opens sync only)
WREN_PIXEL_BASE_URL=
WREN_PIXEL_EXPORT_TOKEN=
WREN_OPEN_TRACKING=false
# Postmaster Tools: the Workspace user that registered the domains (unset = no daily pull)
WREN_POSTMASTER_USER=
# Friday 19:00 report (send timezone); unset = no ReportScheduler
WREN_REPORT_TO=
WREN_REPORT_FROM=
# Gmail domain-wide delegation key (a file path, or the key JSON itself on Lambda) and the sender roster
WREN_GOOGLE_SERVICE_ACCOUNT=~/.config/wren/wren-sender.json
WREN_SENDERS_FILE=senders_config.toml
# Render tier: local (Playwright chromium); cdp (WREN_CDP_URL, a remote chromium such as browserless);
# browserbase (BROWSERBASE_API_KEY + BROWSERBASE_PROJECT_ID in llm.env)
WREN_RENDERER=local
WREN_CDP_URL=
# console prints; gmail sends for real (cutover only)
WREN_SEND_TRANSPORT=console
WREN_DAEMON_TICK_SECONDS=60
WREN_DAEMON_SYNC_SECONDS=300
