# Postgres (docker compose). Password must match WREN_DATABASE_URL.
WREN_DB_PASSWORD=wren
WREN_DATABASE_URL=postgresql://wren:wren@127.0.0.1:5434/wren
# Restate ingress (docker compose)
WREN_RESTATE_INGRESS_URL=http://127.0.0.1:8080
# LinkedIn content pipeline
WREN_INBOX_DIR=inbox
WREN_DRAFTS_DIR=drafts
WREN_LOG_LEVEL=info
# Enrichment / research
# Contact for the outbound User-Agent (email or URL a site operator could reach you at). Required for crawling.
WREN_FETCH_CONTACT=
# warn (fetch anyway, stamp robots_disallowed) | enforce (skip disallowed pages)
WREN_ROBOTS_MODE=warn
# fake | anthropic | groq[:model] | gemini[:model] | openrouter[:model] | cohere[:model] | mistral[:model] | cerebras[:model]
WREN_LLM=fake
WREN_LLM_MODEL=claude-haiku-4-5-20251001
# Key fleets (NUM_<PROVIDER>, <PROVIDER>_API_KEY_N) and WREN_ANTHROPIC_API_KEY live in llm.env (git-ignored).
WREN_LLM_ENV_PATH=llm.env
WREN_TRACING=none
# Mailbox verifier for resolution: fake | millionverifier (MILLIONVERIFIER_API_KEY lives in llm.env)
WREN_VERIFIER=fake
