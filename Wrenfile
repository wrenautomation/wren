# Wrenfile: where each process on this Mac may connect (designs/2026-11-08-egress.md).
# `wren egress check` shows what it compiles to; `wren egress apply` puts the proxies live.
# The relay reads it at each agent launch. Public repo: no client names, no secrets.
version: 1

# No agent shell may read these, and no agent may Read them. `~/` home, `@/` workspace root.
secrets:
  - ~/.aws
  - ~/.ssh
  - ~/.gnupg
  - ~/.netrc
  - ~/.npmrc
  - ~/.docker/config.json
  - ~/.wrangler
  - ~/Library/Keychains
  - ~/.config/anthropic
  - ~/.config/autobrowse
  - ~/.config/gcloud
  - ~/.config/gh
  - ~/.config/internships
  - ~/.config/metered
  - ~/.config/rclone
  - ~/.config/restate
  - ~/.config/solana
  - ~/.config/weaver
  - ~/.config/wren
  - "@/llm.env*"
  - "@/autobrowse/.env*"
  - "@/.wrangler"
  - "@/wren/deploy/*.env"

# One smokescreen per role. open: any public host. report: any public host, a miss is logged.
# enforce: listed hosts only. Every role blocks loopback, private, link-local and CGNAT addresses.
# gate: the key gate's port (credvault): the role's env file holds sentinels for `keys`, and the
# gate swaps in the real key on its vendor's hosts. lock: the role's CLIs reach loopback only.
# env: more env for the role's processes (`~/` is home).
roles:
  agents:
    port: 4761
    mode: report
    hosts:
      - api.anthropic.com
      - mcp-proxy.anthropic.com
  weaver:
    port: 4762
    mode: open
    gate: 4772
    lock: true
    keys:
      - ANTHROPIC_API_KEY*
      - COHERE_API_KEY*
      - EXA_API_KEY*
      - GEMINI_API_KEY*
      - OPENALEX_API_KEY
      - OPENROUTER_API_KEY*
      - PERPLEXITY_API_KEY*
      - WREN_API_TOKEN
      - SEARXNG_TOKEN
      - TYPESAFE_API_KEY
    plain: [NUM_*, SEARXNG_URL]
    # weaver reads its keys from this config's env files: the role's sentinel file
    env: { WEAVER_CONFIG: ~/.config/weaver/gated.json }
  desk:
    port: 4763
    mode: report

# Relay sessions per setup. role: the proxy for claude and its CLIs. run: CLIs that run outside
# the sandbox. hosts: what the sandboxed shell may reach. default: any setup not named here.
agents:
  default:
    role: agents
  weaver:
    role: weaver
    run: [weaver, folders]
  vireo:
    role: agents
    run: [vireo, maker, folders]

# The key gate: real values stay in these files (an earlier file wins a name); only the gate
# reads them. A key whose vendor credvault does not know names its hosts here.
gate:
  sources: ["@/autobrowse/.env", "@/llm.env"]
  hosts:
    WREN_API_TOKEN: [api.wrenautomation.com]
    DESK_DOOR_TOKEN: [api.wrenautomation.com]
    SEARXNG_TOKEN: [search.wrenautomation.com]
