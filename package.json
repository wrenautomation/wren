{
  "name": "wren",
  "description": "Wren Automation: campaigns, channels and client products.",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "turbo run build",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "gates": "./scripts/gates.sh",
    "db:generate": "pnpm --filter @wren/db generate",
    "db:migrate": "pnpm --filter @wren/db migrate",
    "loadtest": "node scripts/loadtest.mjs",
    "worker": "pnpm --filter @wren/worker dev",
    "register": "./scripts/register-worker.sh",
    "wren": "./bin/wren",
    "storybook": "pnpm --filter @wren/portal storybook",
    "offers:export": "pnpm --filter @wren/offers export",
    "templates:export": "pnpm --filter @wren/worker templates:export"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.3",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  },
  "license": "PolyForm-Strict-1.0.0",
  "pnpm": {
    "overrides": {
      "@anthropic-ai/claude-agent-sdk-linux-x64": "-",
      "@anthropic-ai/claude-agent-sdk-linux-arm64": "-",
      "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "-",
      "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "-",
      "@anthropic-ai/claude-agent-sdk-darwin-x64": "-",
      "@anthropic-ai/claude-agent-sdk-darwin-arm64": "-",
      "@anthropic-ai/claude-agent-sdk-win32-x64": "-",
      "@anthropic-ai/claude-agent-sdk-win32-arm64": "-"
    }
  }
}
