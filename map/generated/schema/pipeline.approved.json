    "constraints": [
     "ck_instances_status: CHECK (((status)::text = ANY (ARRAY[('open'::character varying)::text, ('done'::character varying)::text, ('dropped'::character varying)::text])))",
     "ck_instances_subject: CHECK (((((subject_kind)::text = 'person'::text) AND (profile_id IS NOT NULL) AND (document_id IS NULL)) OR (((subject_kind)::text = 'document'::text) AND (document_id IS NOT NULL) AND (profile_id IS NULL))))",
     "ck_instances_subject_kind: CHECK (((subject_kind)::text = ANY (ARRAY[('person'::character varying)::text, ('document'::character varying)::text])))",
     "fk_instances_document_id_documents: FOREIGN KEY (document_id) REFERENCES documents(id)",
     "fk_instances_profile_id_profiles: FOREIGN KEY (profile_id) REFERENCES profiles(id)",
     "fk_instances_shape_version: FOREIGN KEY (version) REFERENCES pipeline.shape_versions(number)",
