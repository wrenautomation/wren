   "attrs": {
    "columns": [
     "collected_cents bigint = 0",
     "currency varchar(3) = 'USD'::character varying",
     "ends_at timestamp with time zone null",
     "engagement_id integer null",
     "id uuid = gen_random_uuid()",
     "journey uuid",
     "node varchar(40) null",
     "offer varchar(64)",
     "offer_version integer",
     "profile_id integer",
     "signed_at timestamp with time zone = now()",
     "status varchar(5) = 'open'::character varying",
     "terms_version integer null"
    ],
    "constraints": [
     "ck_deals_status: CHECK (((status)::text = ANY (ARRAY[('open'::character varying)::text, ('won'::character varying)::text, ('lost'::character varying)::text, ('ended'::character varying)::text])))",
     "fk_deals_journey_instances: FOREIGN KEY (journey) REFERENCES pipeline.instances(id)",
     "fk_deals_profile_id_profiles: FOREIGN KEY (profile_id) REFERENCES profiles(id)",
     "fk_deals_terms_version_terms_versions: FOREIGN KEY (terms_version) REFERENCES pipeline.terms_versions(id)",
     "pk_deals: PRIMARY KEY (id)",
     "uq_deals_journey_node: UNIQUE (journey, node)"
    ],
    "kind": "table"
   }
