    "columns": [
     "bucket varchar(16) null",
     "channel varchar(16) null",
     "created_at timestamp with time zone = now()",
     "id integer = nextval('books.accounts_id_seq'::regclass)",
     "key varchar(64)",
     "name text",
     "t2125_line varchar(8) null",
     "type varchar(16)"
    ],
    "constraints": [
     "ck_accounts_bucket: CHECK (((bucket)::text = ANY (ARRAY[('acquisition'::character varying)::text, ('delivery'::character varying)::text, ('overhead'::character varying)::text])))",
     "ck_accounts_channel: CHECK (((channel)::text = ANY (ARRAY[('email'::character varying)::text, ('sms'::character varying)::text, ('ads'::character varying)::text, ('content'::character varying)::text, ('search'::character varying)::text, ('reach'::character varying)::text])))",
     "ck_accounts_type: CHECK (((type)::text = ANY (ARRAY[('asset'::character varying)::text, ('liability'::character varying)::text, ('equity'::character varying)::text, ('income'::character varying)::text, ('expense'::character varying)::text])))",
     "pk_accounts: PRIMARY KEY (id)",
     "uq_accounts_key: UNIQUE (key)"
    ],
    "kind": "table"
   }
  },
