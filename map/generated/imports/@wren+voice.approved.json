    "description": "A finished call into `voice_calls`, its turns into `voice_turns`, in one transaction"
   }
  },
  {
   "id": "@wren/voice/src/tools.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "What the agent can do on a call: look up the lead, offer times and book on our calendar, transfer to a person, take a message, end the call"
   }
  },
  {
   "id": "@wren/voice/src/transports/browser.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "A spoken test call in the browser at $0: the browser's own speech recognition is the ears and its speech synthesis the mouth, so the session sees text, as on a typed call"
