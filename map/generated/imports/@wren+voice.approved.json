   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "Spoken commands in dictated words: \"new line\" is a line break, \"period\" a full stop"
   }
  },
  {
   "id": "@wren/voice/src/dictation/ears.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "Ears from any batch model"
   }
  },
  {
   "id": "@wren/voice/src/dictation/index.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "Dictation: speech to text in the portal, through the voice agent's `Ears`"
   }
  },
  {
   "id": "@wren/voice/src/dictation/route.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "Which ears a dictation uses: the model in the browser when it has WebGPU, else our server when it's on, else the browser's own speech if the person allowed it, else none, with why"
   }
  },
  {
   "id": "@wren/voice/src/dictation/session.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "One dictation, from the press to the last words in the box: the mic's frames go to the ears, their words come back with the spoken commands applied, and each stage is timed"
   }
  },
  {
   "id": "@wren/voice/src/dictation/transcriber.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "A batch speech model, under the `Ears` seam: 16 kHz mono audio in, words out"
   }
  },
  {
   "id": "@wren/voice/src/fakes.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "A fake for every piece, so a whole call runs with no vendor: a scripted caller on a fake phone line, ears that read the fake audio as words, a mouth that turns words into fake audio, a brain that follows simple rules, and fake lead, calendar and message ports"
   }
  },
  {
   "id": "@wren/voice/src/index.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "The voice agent's isomorphic core: the interface, the agent, its tools, the call loop, the fakes and the text and browser transports"
   }
  },
  {
   "id": "@wren/voice/src/node.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "The voice agent's Node side: Postgres ports, the dial rules, saving calls, Telnyx"
   }
  },
  {
   "id": "@wren/voice/src/ports.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "The tools' ports on Postgres: who a number is (the SMS contact behind it), our calendar (`@wren/calendar`'s exported functions, nothing else), and messages"
   }
  },
  {
   "id": "@wren/voice/src/reading.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "Reading aloud: text to speech in the portal, through the voice agent's `Mouth`"
   }
  },
  {
   "id": "@wren/voice/src/records.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "The Voice app's records: calls (each with its transcript and timed turns) and latency (p50 and p95 per stage per pipeline)"
   }
  },
  {
   "id": "@wren/voice/src/schema.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "The voice agent's tables"
   }
  },
  {
   "id": "@wren/voice/src/sentences.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
   "attrs": {
    "description": "Cut streamed text into sentences, so the first one goes to the mouth before the reply ends"
   }
  },
  {
   "id": "@wren/voice/src/store.ts",
   "role": "file",
   "parent": "@wren/voice",
   "group": "@wren/voice",
