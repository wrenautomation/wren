  },
  {
   "id": "@wren/starling-core/src/thread.ts",
   "role": "file",
   "parent": "@wren/starling-core",
   "group": "@wren/starling-core",
   "attrs": {
    "description": "An X thread in one draft: the posts live in the draft's text, split by a line holding only `---`, so the draft box, Ask Claude, history and undo work on it like any post"
   }
  },
  {
   "id": "@wren/starling-core/src/tiktok.ts",
   "role": "file",
   "parent": "@wren/starling-core",
   "group": "@wren/starling-core",
