   "attrs": {
    "description": "The content channel port: what publishing organic content to a platform looks like from this repo, whichever way the adapter does it (the platform's API, or an autobrowse flow where the API is gated or absent)"
   }
  },
  {
   "id": "@wren/starling-core/src/insights.ts",
