   "parent": "@wren/starling-core",
   "group": "@wren/starling-core",
   "attrs": {
    "description": "A post's and an account's deeper numbers: whatever the platform's token can read, as long rows (`metric`, `key`, `value`), plus a gap per number it can't, with the platform's own words"
   }
  },
  {
   "id": "@wren/starling-core/src/page-inbox.ts",
   "role": "file",
   "parent": "@wren/starling-core",
   "group": "@wren/starling-core",
   "attrs": {
    "description": "A Facebook Page's inbox (Messenger, or its Instagram), as autobrowse `meta GET /{pageId}/conversations` reads it with the Page's own token"
   }
  },
  {
   "id": "@wren/starling-core/src/proof.ts",
   "role": "file",
   "parent": "@wren/starling-core",
   "group": "@wren/starling-core",
   "attrs": {
    "description": "Comment proof: is a comment we sent there for a stranger? `CommentProof.check` answers with a `Proof`: live, hidden (only its author sees it), missing (gone) or pending (no reader yet, or none answered)"
   }
  },
  {
   "id": "@wren/starling-core/src/service.ts",
   "role": "file",
