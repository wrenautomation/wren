{
 "layer": "routes",
 "nodes": [
  {
   "id": "route:SearchWeek/run",
   "role": "route",
   "parent": "service:SearchWeek",
   "group": "@wren/channel-search",
   "attrs": {
    "deps": [
     "console",
     "db",
     "desk",
     "fetch",
     "llm",
     "notifier",
     "origin"
    ],
    "input": "{ today: string }",
    "output": "WeekStats",
    "reaches": [
     "SiteClient.call(_, !GET)"
    ],
    "wrap": "serviceHandler"
   }
  },
  {
   "id": "service:SearchWeek",
   "role": "service",
   "parent": "@wren/channel-search",
   "group": "@wren/channel-search",
   "attrs": {
    "factory": "makeSearchWeek",
    "file": "packages/channel-search/src/restate/watch.ts",
    "kind": "service"
   }
  }
 ],
 "edges": [
  {
   "from": "route:SearchWeek/run",
   "to": "table:public.search_days",
   "kind": "reads"
  },
  {
   "from": "route:SearchWeek/run",
   "to": "table:public.runs",
   "kind": "writes"
  },
  {
   "from": "route:SearchWeek/run",
   "to": "table:public.search_answers",
   "kind": "writes"
  },
  {
   "from": "route:SearchWeek/run",
   "to": "table:public.search_keywords",
   "kind": "writes"
  }
 ]
}
