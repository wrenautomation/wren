# img-src: a note's images are signed S3 links (packages/notes, `notes/file`).
# connect-src: S3 takes client file uploads on a signed PUT (packages/delivery/src/files.ts);
# npm's registry lists the browser mods (Marketplace). Dictation's speech model
# (src/dictation/model.worker.ts): weights from Hugging Face (redirects to *.hf.co); onnxruntime's
# wasm is ours (/ort/), and 'wasm-unsafe-eval' compiles it. frame-src: the session player is ours
# (/replay); Learn plays YouTube (no-cookie), Instagram, TikTok and X posts in their own embeds.
# Learn's thumbnails and audio come through our /media (src/media.ts), so img-src stays put.
# style-src hashes: the stylesheets of a site page's and a slide's preview, srcdoc frames that keep
# this policy (test/preview-styles.test.ts names a changed one).
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://*.s3.us-east-1.amazonaws.com; style-src 'self' 'sha256-3ujlhpl+EV0g5RElZhtAkAmAQtjKr3SFJ1zM+XJZslY=' 'sha256-QcvA7qH8btG+M8jA1iC9hSD+LThUanM9HZ0xqGOfTjo='; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://auth.wrenautomation.com https://*.s3.us-east-1.amazonaws.com https://registry.npmjs.org https://huggingface.co https://*.hf.co; frame-src 'self' https://www.youtube-nocookie.com https://www.instagram.com https://www.tiktok.com https://platform.twitter.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex

# Hashed build files never change under their name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
