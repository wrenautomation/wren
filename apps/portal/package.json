{
  "name": "@wren/portal",
  "description": "The client portal and operator app.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p scripts",
    "test:unit": "vitest run",
    "build": "vite build web",
    "dev": "node ../../scripts/secrets.mjs run /wren/prod/env -- vite web",
    "deploy": "vite build web && wrangler deploy",
    "preview": "vite build web && tsx scripts/preview.ts",
    "e2e:writes": "tsx scripts/writes-e2e.ts",
    "e2e:outreach": "tsx scripts/outreach-e2e.ts",
    "storybook": "wren-storybook 61001",
    "stories:build": "storybook build --quiet",
    "stories:shot": "wren-shot --port 61001",
    "look": "wren-look --port 61001",
    "test:stories": "wren-stories",
    "kestrel:screens": "tsx scripts/screens.ts"
  },
