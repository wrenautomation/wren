{
  "name": "@wren/worker",
  "description": "Every Restate service, served from Lambda and the box.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components": "./src/components.ts",
    "./setups": "./src/setups.ts",
