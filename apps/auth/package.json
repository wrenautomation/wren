{
  "name": "@wren/auth-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p lambda",
    "test:unit": "vitest run",
